<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Free Bots · Deriv Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: #f7f9fc;
            color: #101828;
            padding-bottom: 100px; /* space for bottom bar */
            min-height: 100vh;
        }

        /* ---------- HEADER ---------- */
        .top-nav {
            background: #ffffff;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #eef1f6;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .menu-icon {
            font-size: 20px;
            color: #344054;
            cursor: pointer;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 700;
            font-size: 16px;
            color: #1d2939;
        }

        .brand-icon {
            width: 24px;
            height: 24px;
            background: linear-gradient(135deg, #6d5efc, #4f46e5);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 12px;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .login-link {
            color: #344054;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            padding: 8px 12px;
        }

        .signup-btn {
            background: #ffffff;
            color: #4f46e5;
            border: 2px solid #4f46e5;
            padding: 8px 18px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: 0.2s;
            text-decoration: none;
        }

        .signup-btn:hover {
            background: #4f46e5;
            color: #fff;
        }

        /* ---------- TABS ---------- */
        .tabs {
            display: flex;
            gap: 10px;
            padding: 16px 18px;
            overflow-x: auto;
            background: #ffffff;
            border-bottom: 1px solid #eef1f6;
            scrollbar-width: none;
        }

        .tabs::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            border-radius: 30px;
            background: #fff;
            border: 1.5px solid #e4e7ec;
            color: #344054;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: 0.2s;
        }

        .tab.active {
            background: #eef2ff;
            border-color: #4f46e5;
            color: #4f46e5;
        }

        .tab i { font-size: 13px; }

        /* ---------- HERO ---------- */
        .hero {
            padding: 20px 18px 10px;
        }

        .hero h1 {
            font-size: 24px;
            font-weight: 800;
            color: #1d2939;
            margin-bottom: 4px;
        }

        .hero h2 {
            font-size: 16px;
            font-weight: 600;
            color: #475467;
            margin-bottom: 6px;
        }

        .hero p {
            font-size: 13.5px;
            color: #667085;
            line-height: 1.5;
            max-width: 90%;
        }

        /* ---------- BOT CARDS ---------- */
        .bot-list {
            padding: 12px 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .bot-card {
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(16, 24, 40, 0.06);
            border: 1px solid #f0f2f5;
            transition: transform 0.2s;
        }

        .bot-card:hover {
            transform: translateY(-2px);
        }

        .bot-image {
            position: relative;
            height: 220px;
            background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .bot-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* fallback robot art */
        .bot-image .robot-art {
            font-size: 80px;
            color: rgba(255,255,255,0.7);
        }

        .badge-tl {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(255,255,255,0.95);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #b54708;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .badge-tr {
            position: absolute;
            top: 14px;
            right: 14px;
            background: #1d2939;
            color: #fff;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .bot-body {
            padding: 16px;
        }

        .bot-tag {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: #b54708;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .bot-title {
            font-size: 18px;
            font-weight: 700;
            color: #1d2939;
            margin-bottom: 12px;
        }

        .unlock-btn {
            width: 100%;
            background: linear-gradient(90deg, #b45309, #d97706);
            color: #fff;
            border: none;
            padding: 14px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: 0.2s;
            box-shadow: 0 4px 12px rgba(180, 83, 9, 0.3);
        }

        .unlock-btn:hover {
            filter: brightness(1.05);
            transform: scale(1.01);
        }

        /* second card variant */
        .bot-card.v2 .badge-tl {
            background: rgba(255,255,255,0.95);
            color: #b42318;
        }

        .bot-card.v2 .bot-image {
            background: linear-gradient(135deg, #fce7f3, #e9d5ff);
        }

        .bot-card.v2 .bot-tag {
            color: #b42318;
        }

        /* ---------- BOTTOM RUN BAR ---------- */
        .run-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #ffffff;
            padding: 12px 16px;
            border-top: 1px solid #eef1f6;
            box-shadow: 0 -4px 20px rgba(16, 24, 40, 0.06);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 100;
        }

        .run-btn {
            background: #14b8a6;
            color: #fff;
            border: none;
            padding: 12px 22px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: 0.2s;
        }

        .run-btn:hover { background: #0d9488; }

        .speed-pill {
            background: #ecfdf5;
            border: 1.5px solid #14b8a6;
            border-radius: 12px;
            padding: 8px 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 70px;
        }

        .speed-pill .label {
            font-size: 8px;
            font-weight: 800;
            color: #14b8a6;
            letter-spacing: 0.5px;
        }

        .speed-pill .value {
            font-size: 13px;
            font-weight: 800;
            color: #065f46;
        }

        .status-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }

        .status-text {
            font-size: 13px;
            font-weight: 700;
            color: #475467;
        }

        .progress-dots {
            display: flex;
            gap: 6px;
        }

        .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #d0d5dd;
        }

        .dot.active {
            background: #14b8a6;
            width: 18px;
            border-radius: 4px;
        }

        /* ---------- RESPONSIVE ---------- */
        @media (min-width: 768px) {
            .bot-list {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }
            .run-bar {
                max-width: 720px;
                left: 50%;
                transform: translateX(-50%);
                border-radius: 20px 20px 0 0;
            }
        }

        @media (min-width: 1024px) {
            .bot-list {
                grid-template-columns: repeat(3, 1fr);
            }
        }
    </style>
</head>
<body>

    <!-- TOP NAV -->
    <div class="top-nav">
        <div class="nav-left">
            <i class="fas fa-bars menu-icon"></i>
            <div class="brand">
                <div class="brand-icon"><i class="fas fa-bolt"></i></div>
                Pypnex AI
            </div>
        </div>
        <div class="nav-right">
            <a href="#" class="login-link">Log in</a>
            <a href="#" class="signup-btn">Sign up</a>
        </div>
    </div>

    <!-- TABS -->
    <div class="tabs">
        <div class="tab active"><i class="fas fa-th-large"></i> Free Bots</div>
        <div class="tab"><i class="fas fa-layer-group"></i> Bulk Trader</div>
        <div class="tab"><i class="fas fa-chart-line"></i> Dashboard</div>
        <div class="tab"><i class="fas fa-cog"></i> Settings</div>
    </div>

    <!-- HERO -->
    <div class="hero">
        <h1>Pipnex AI</h1>
        <h2>Free bots</h2>
        <p>Load a bot and start trading — no setup, no noise.</p>
    </div>

    <!-- BOT LIST -->
    <div class="bot-list">

        <!-- CARD 1 -->
        <div class="bot-card">
            <div class="bot-image">
                <div class="badge-tl">OVER / UNDER</div>
                <div class="badge-tr">PROTECTED</div>
                <!-- Replace with real image -->
                <i class="fas fa-robot robot-art"></i>
            </div>
            <div class="bot-body">
                <div class="bot-tag">Password required</div>
                <div class="bot-title">Tradescript Bullets</div>
                <button class="unlock-btn">
                    <i class="fas fa-download"></i> Unlock & load
                </button>
            </div>
        </div>

        <!-- CARD 2 -->
        <div class="bot-card v2">
            <div class="bot-image">
                <div class="badge-tl">OVER / UNDER</div>
                <div class="badge-tr">PROTECTED</div>
                <i class="fas fa-bolt robot-art"></i>
            </div>
            <div class="bot-body">
                <div class="bot-tag">Free strategy</div>
                <div class="bot-title">Storm Rider AI</div>
                <button class="unlock-btn">
                    <i class="fas fa-download"></i> Unlock & load
                </button>
            </div>
        </div>

    </div>

    <!-- BOTTOM RUN BAR -->
    <div class="run-bar">
        <button class="run-btn">
            <i class="fas fa-play"></i> Run
        </button>
        <div class="speed-pill">
            <span class="label">EXECUTION</span>
            <span class="value">FAST</span>
        </div>
        <div class="status-area">
            <div class="status-text">Bot is not running</div>
            <div class="progress-dots">
                <div class="dot active"></div>
                <div class="dot"></div>
                <div class="dot"></div>
            </div>
        </div>
    </div>

    <script>
        // Tab switching (visual only)
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
            });
        });

        // Unlock button demo
        document.querySelectorAll('.unlock-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                alert('🔒 This demo bot requires a password to unlock. Add your own bot logic here.');
            });
        });

        // Run button demo
        document.querySelector('.run-btn').addEventListener('click', () => {
            const status = document.querySelector('.status-text');
            const dots = document.querySelectorAll('.dot');
            if (status.textContent.includes('not running')) {
                status.textContent = 'Bot is running…';
                dots.forEach((d, i) => {
                    if (i === 1) d.classList.add('active');
                    if (i === 2) d.classList.remove('active');
                });
            } else {
                status.textContent = 'Bot is not running';
                dots.forEach((d, i) => {
                    if (i === 0) d.classList.add('active');
                    else d.classList.remove('active');
                });
            }
        });
    </script>

</body>
</html>