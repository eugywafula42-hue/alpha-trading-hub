<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deriv Bot Dashboard · free</title>
    <!-- FontAwesome for icons, minimal & free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background: #0b0e14;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 1.5rem;
        }

        .dashboard {
            max-width: 1200px;
            width: 100%;
            background: #141a24;
            border-radius: 2rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.03);
            padding: 2rem 2rem 2rem 2rem;
            transition: all 0.2s;
            border: 1px solid #2a3440;
        }

        /* header */
        .header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            gap: 1rem;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo-icon {
            background: #00d4aa;
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px -8px #00d4aa80;
        }

        .logo-icon i {
            font-size: 1.8rem;
            color: #0b0e14;
        }

        .logo-text h1 {
            font-size: 1.7rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: #f0f4fa;
            line-height: 1.2;
        }

        .logo-text .badge {
            font-size: 0.7rem;
            font-weight: 500;
            background: #1e2a36;
            color: #9aa8b9;
            padding: 0.2rem 0.7rem;
            border-radius: 40px;
            display: inline-block;
            margin-top: 2px;
            border: 1px solid #2f3d4c;
        }

        .status-pill {
            background: #0f1a1f;
            border-radius: 60px;
            padding: 0.45rem 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            border: 1px solid #2b3b46;
            box-shadow: inset 0 2px 4px #00000030;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            background: #00d4aa;
            border-radius: 50%;
            box-shadow: 0 0 10px #00d4aa;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.1); }
            100% { opacity: 0.8; transform: scale(1); }
        }

        .status-pill span {
            color: #b6c8da;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* add bot panel */
        .add-bot-section {
            background: #0f151e;
            border-radius: 1.5rem;
            padding: 1.5rem 1.8rem;
            margin-bottom: 2.2rem;
            border: 1px solid #25313d;
            box-shadow: 0 10px 20px -10px #00000050;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .add-bot-section .label-group {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .add-bot-section .label-group i {
            font-size: 1.4rem;
            color: #00d4aa;
            background: #0a1c1a;
            padding: 0.5rem;
            border-radius: 12px;
            width: 46px;
            text-align: center;
        }

        .add-bot-section .label-group h3 {
            font-size: 1.2rem;
            font-weight: 500;
            color: #e3eaf2;
        }

        .add-bot-section .label-group p {
            color: #7b8a9b;
            font-size: 0.85rem;
            margin-top: 2px;
        }

        .input-cluster {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .input-cluster input {
            background: #1d2733;
            border: 1px solid #2e3d4b;
            border-radius: 60px;
            padding: 0.85rem 1.4rem;
            font-size: 0.95rem;
            color: #f0f4fa;
            width: 240px;
            outline: none;
            transition: all 0.2s;
            font-weight: 400;
        }

        .input-cluster input::placeholder {
            color: #5d6f82;
            font-weight: 400;
        }

        .input-cluster input:focus {
            border-color: #00d4aa;
            box-shadow: 0 0 0 3px #00d4aa20;
            background: #1a2531;
        }

        .btn-primary {
            background: #00d4aa;
            border: none;
            border-radius: 60px;
            padding: 0.85rem 1.8rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: #0b0e14;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 8px 18px -6px #00d4aa70;
            white-space: nowrap;
            border: 1px solid #00e6bb;
        }

        .btn-primary i {
            font-size: 1rem;
        }

        .btn-primary:hover {
            background: #00e6bb;
            transform: scale(1.02);
            box-shadow: 0 12px 24px -8px #00d4aa;
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        /* bot grid */
        .bot-grid-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.2rem;
            padding: 0 0.25rem;
        }

        .bot-grid-header h2 {
            font-size: 1.3rem;
            font-weight: 500;
            color: #d0dceb;
            letter-spacing: -0.01em;
        }

        .bot-grid-header h2 i {
            color: #00d4aa;
            margin-right: 0.5rem;
        }

        .bot-count {
            background: #1d2733;
            border-radius: 40px;
            padding: 0.3rem 1rem;
            font-size: 0.85rem;
            color: #9bb0c5;
            border: 1px solid #2d3b48;
            font-weight: 500;
        }

        .bot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.2rem;
            margin-top: 0.5rem;
            min-height: 180px;
        }

        .bot-card {
            background: #10171f;
            border-radius: 1.3rem;
            padding: 1.4rem 1.3rem 1.3rem 1.3rem;
            border: 1px solid #26323f;
            box-shadow: 0 6px 14px -6px #00000060;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            position: relative;
            backdrop-filter: blur(2px);
        }

        .bot-card:hover {
            border-color: #2f4050;
            background: #131c26;
            transform: translateY(-2px);
            box-shadow: 0 18px 28px -12px #00000090;
        }

        .bot-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .bot-card .card-header .bot-name {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .bot-card .card-header .bot-name i {
            color: #00d4aa;
            background: #0d211f;
            padding: 0.5rem;
            border-radius: 12px;
            font-size: 1rem;
            width: 36px;
            text-align: center;
            border: 1px solid #1f3a35;
        }

        .bot-card .card-header .bot-name h3 {
            font-size: 1.1rem;
            font-weight: 600;
            color: #eef3f9;
            word-break: break-word;
            max-width: 150px;
        }

        .bot-card .card-header .bot-actions {
            display: flex;
            gap: 0.4rem;
        }

        .icon-btn {
            background: #1b2531;
            border: none;
            border-radius: 10px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8b9eb1;
            cursor: pointer;
            transition: all 0.15s;
            border: 1px solid #2b3847;
            font-size: 0.8rem;
        }

        .icon-btn:hover {
            background: #263542;
            color: #d3e2f0;
            border-color: #3e5568;
        }

        .icon-btn.delete-btn:hover {
            background: #3a1f28;
            color: #ff7a8b;
            border-color: #6b3a47;
        }

        .bot-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem 1rem;
            font-size: 0.75rem;
            color: #7a8ea3;
            margin: 0.7rem 0 0.2rem 0;
            border-top: 1px solid #1d2936;
            padding-top: 0.9rem;
            margin-top: auto;
        }

        .bot-meta span {
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .bot-meta i {
            font-size: 0.7rem;
            color: #00d4aa;
        }

        .empty-state {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
            background: #10171f;
            border-radius: 1.5rem;
            border: 1px dashed #2b3d4b;
            color: #6a7e94;
            text-align: center;
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: #2d4052;
        }

        .empty-state p {
            font-size: 1rem;
            max-width: 300px;
        }

        .empty-state .small-note {
            font-size: 0.8rem;
            color: #4d6275;
            margin-top: 0.5rem;
        }

        /* toast notification (subtle) */
        .toast-message {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #1d2b36;
            backdrop-filter: blur(10px);
            color: #e3f0fa;
            padding: 0.8rem 1.8rem;
            border-radius: 60px;
            font-size: 0.9rem;
            border: 1px solid #00d4aa50;
            box-shadow: 0 20px 35px -10px #000000;
            opacity: 0;
            transition: opacity 0.2s;
            pointer-events: none;
            z-index: 999;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .toast-message.show {
            opacity: 1;
        }

        .toast-message i {
            color: #00d4aa;
        }

        /* responsive */
        @media (max-width: 700px) {
            .dashboard {
                padding: 1.5rem;
            }
            .add-bot-section {
                flex-direction: column;
                align-items: stretch;
            }
            .input-cluster {
                width: 100%;
            }
            .input-cluster input {
                flex: 1;
                width: auto;
                min-width: 150px;
            }
            .btn-primary {
                justify-content: center;
            }
            .logo-text h1 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <!-- header -->
        <div class="header">
            <div class="logo-area">
                <div class="logo-icon">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="logo-text">
                    <h1>Deriv Bot Dashboard</h1>
                    <span class="badge"><i class="fas fa-gift" style="margin-right: 5px;"></i>free · unlimited</span>
                </div>
            </div>
            <div class="status-pill">
                <div class="status-dot"></div>
                <span>connected · deriv api</span>
            </div>
        </div>

        <!-- add bot section -->
        <div class="add-bot-section">
            <div class="label-group">
                <i class="fas fa-plus-circle"></i>
                <div>
                    <h3>Add your free bot</h3>
                    <p>Name your Deriv bot (e.g., "RSI master", "MACD cross")</p>
                </div>
            </div>
            <div class="input-cluster">
                <input type="text" id="botNameInput" placeholder="Enter bot name..." maxlength="40" autocomplete="off">
                <button class="btn-primary" id="addBotBtn">
                    <i class="fas fa-cloud-upload-alt"></i> Add bot
                </button>
            </div>
        </div>

        <!-- bot list header -->
        <div class="bot-grid-header">
            <h2><i class="fas fa-microchip"></i> My Deriv bots</h2>
            <span class="bot-count" id="botCount">0 bots</span>
        </div>

        <!-- dynamic bot grid -->
        <div class="bot-grid" id="botGrid">
            <!-- filled via js, initial empty state will be injected -->
        </div>
    </div>

    <!-- toast -->
    <div class="toast-message" id="toast">
        <i class="fas fa-check-circle"></i> <span id="toastText">Bot added</span>
    </div>

    <script>
        (function(){
            // --- state & storage ---
            let bots = [];

            // load from localStorage (free persistent storage)
            function loadBots() {
                try {
                    const stored = localStorage.getItem('deriv_free_bots');
                    if (stored) {
                        bots = JSON.parse(stored);
                        // ensure each bot has an id, if not (legacy) assign
                        bots = bots.map(b => {
                            if (!b.id) b.id = crypto.randomUUID ? crypto.randomUUID() : Date.now() + Math.random().toString(36);
                            return b;
                        });
                    } else {
                        // start with a couple of sample bots to demonstrate
                        bots = [
                            { id: crypto.randomUUID ? crypto.randomUUID() : '1', name: 'RSI Crossover', created: Date.now() - 86400000 * 2 },
                            { id: crypto.randomUUID ? crypto.randomUUID() : '2', name: 'MACD Momentum', created: Date.now() - 86400000 * 5 },
                            { id: crypto.randomUUID ? crypto.randomUUID() : '3', name: 'Bollinger Bounce', created: Date.now() - 86400000 * 1 }
                        ];
                    }
                } catch (e) {
                    console.warn('localStorage error, using defaults');
                    bots = [
                        { id: '1', name: 'RSI Crossover', created: Date.now() - 86400000 * 2 },
                        { id: '2', name: 'MACD Momentum', created: Date.now() - 86400000 * 5 },
                    ];
                }
                // ensure every bot has an id and created field
                bots = bots.map(b => {
                    if (!b.id) b.id = crypto.randomUUID ? crypto.randomUUID() : Date.now() + Math.random().toString(36);
                    if (!b.created) b.created = Date.now();
                    return b;
                });
                renderBots();
            }

            function saveBots() {
                try {
                    localStorage.setItem('deriv_free_bots', JSON.stringify(bots));
                } catch (e) {
                    console.warn('Could not save to localStorage');
                }
            }

            // --- render bot cards ---
            function renderBots() {
                const grid = document.getElementById('botGrid');
                const countSpan = document.getElementById('botCount');
                if (!grid) return;

                // update counter
                countSpan.textContent = bots.length + (bots.length === 1 ? ' bot' : ' bots');

                if (bots.length === 0) {
                    grid.innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-robot"></i>
                            <p>No bots yet. Add your first Deriv bot above — it's free!</p>
                            <div class="small-note">Each bot gets a unique ID & runs on your account.</div>
                        </div>
                    `;
                    return;
                }

                // sort by creation date (newest first)
                const sorted = [...bots].sort((a, b) => (b.created || 0) - (a.created || 0));

                let html = '';
                sorted.forEach(bot => {
                    // format relative time or simple date
                    const createdDate = bot.created ? new Date(bot.created) : new Date();
                    const dateStr = createdDate.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    const timeStr = createdDate.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });

                    // escape bot name for safety
                    const safeName = bot.name.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

                    html += `
                        <div class="bot-card" data-bot-id="${bot.id}">
                            <div class="card-header">
                                <div class="bot-name">
                                    <i class="fas fa-bolt"></i>
                                    <h3>${safeName}</h3>
                                </div>
                                <div class="bot-actions">
                                    <button class="icon-btn delete-btn" data-id="${bot.id}" title="Delete bot">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="bot-meta">
                                <span><i class="fas fa-fingerprint"></i> ID: ${bot.id.slice(0, 8)}…</span>
                                <span><i class="far fa-calendar-alt"></i> ${dateStr} ${timeStr}</span>
                                <span><i class="fas fa-circle" style="color: #00d4aa; font-size: 0.5rem;"></i> active</span>
                            </div>
                        </div>
                    `;
                });
                grid.innerHTML = html;

                // attach delete listeners to all delete buttons
                document.querySelectorAll('.delete-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const id = btn.getAttribute('data-id');
                        if (id) deleteBot(id);
                    });
                });
            }

            // --- add bot ---
            function addBot() {
                const input = document.getElementById('botNameInput');
                const name = input.value.trim();

                if (!name) {
                    showToast('Please enter a bot name', '⚠️');
                    input.focus();
  